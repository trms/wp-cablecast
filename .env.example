# Copy to .env to override defaults. All values are optional.

# Host port for the dev site (http://localhost:8080)
WP_PORT=8080
# Host port for phpMyAdmin (`make tools`)
PMA_PORT=8081

# PHP version for the dev site image (any wordpress:php<ver>-apache tag)
WP_PHP_VERSION=8.2

# Cablecast server the dev site syncs from
CABLECAST_SERVER=https://rays-house.cablecast.net

# Xdebug mode for the dev site: off, debug, profile, develop, ...
XDEBUG_MODE=debug

# Default PHP / WordPress versions for `make test`
PHP_VERSION=8.2
WP_VERSION=latest
